# Copy to .env and fill in. Every value is optional — see README for behavior.

# SQLite for local dev. In serverless, point at a real DB or leave unset
# (DB-backed routes degrade gracefully).
DATABASE_URL="file:./db/custom.db"

# GitHub PAT — lifts the live-data rate limit from 60 to 5,000 req/hr.
# Without it the site still works (cached + fallback data).
GITHUB_TOKEN=""

# Token that unlocks the admin back-office at /?admin=1.
# Defaults to a dev-only token when unset; ALWAYS set a strong value in production.
PORTFOLIO_ADMIN_TOKEN=""

# Public site URL (OG metadata, sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
